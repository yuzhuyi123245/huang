const express = require("express");
const multer = require("multer");
const cookieParser = require("cookie-parser");
const fs = require("fs");
const path = require("path");
const crypto = require("crypto");

const app = express();
const PORT = process.env.PORT || 3000;

const ADMIN_PASSWORD = process.env.ADMIN_PASSWORD || "004913";
const GUEST_PASSWORD = process.env.GUEST_PASSWORD || "000000";
const SESSION_SECRET =
  process.env.SESSION_SECRET || "change-this-secret";

const dataDir = path.join(__dirname, "data");
const uploadDir = path.join(dataDir, "uploads");

fs.mkdirSync(uploadDir, { recursive: true });

const dbFile = path.join(dataDir, "content.json");

if (!fs.existsSync(dbFile)) {
  fs.writeFileSync(
    dbFile,
    JSON.stringify(
      {
        text: "",
        image: ""
      },
      null,
      2
    )
  );
}

function readDB() {
  return JSON.parse(fs.readFileSync(dbFile, "utf8"));
}

function writeDB(data) {
  fs.writeFileSync(dbFile, JSON.stringify(data, null, 2));
}

function sign(role) {
  return crypto
    .createHmac("sha256", SESSION_SECRET)
    .update(role)
    .digest("hex");
}

function setSession(res, role) {
  res.cookie(
    "session",
    role + "." + sign(role),
    {
      httpOnly: true,
      sameSite: "lax",
      secure: process.env.NODE_ENV === "production",
      maxAge: 7 * 24 * 60 * 60 * 1000
    }
  );
}

function getRole(req) {
  const cookie = req.headers.cookie;

  if (!cookie) {
    return null;
  }

  const match = cookie.match(
    /(?:^|; )session=([^;]+)/
  );

  if (!match) {
    return null;
  }

  const value = decodeURIComponent(match[1]);
  const parts = value.split(".");

  if (parts.length !== 2) {
    return null;
  }

  const role = parts[0];
  const signature = parts[1];

  if (
    (role === "admin" || role === "guest") &&
    signature === sign(role)
  ) {
    return role;
  }

  return null;
}

function adminOnly(req, res, next) {
  if (getRole(req) !== "admin") {
    return res.status(403).json({
      error: "需要管理者权限"
    });
  }

  next();
}

app.use(cookieParser());
app.use(express.json({ limit: "1mb" }));

app.use(
  express.static(
    path.join(__dirname, "public")
  )
);

app.post("/api/login", (req, res) => {
  const password = String(
    req.body?.password || ""
  );

  if (password === ADMIN_PASSWORD) {
    setSession(res, "admin");

    return res.json({
      role: "admin"
    });
  }

  if (password === GUEST_PASSWORD) {
    setSession(res, "guest");

    return res.json({
      role: "guest"
    });
  }

  return res.status(401).json({
    error: "密码错误"
  });
});

app.get("/api/content", (req, res) => {
  const data = readDB();

  res.json(data);
});

app.put(
  "/api/content",
  adminOnly,
  (req, res) => {
    const data = readDB();

    data.text = String(
      req.body?.text || ""
    );

    writeDB(data);

    res.json({
      ok: true
    });
  }
);

const storage =
  multer.diskStorage({
    destination: uploadDir,

    filename: (req, file, cb) => {
      const ext = path
        .extname(file.originalname)
        .toLowerCase();

      const filename =
        Date.now() +
        "-" +
        crypto
          .randomBytes(6)
          .toString("hex") +
        ext;

      cb(null, filename);
    }
  });

const upload = multer({
  storage,

  limits: {
    fileSize: 8 * 1024 * 1024
  },

  fileFilter: (req, file, cb) => {
    if (!file.mimetype.startsWith("image/")) {
      return cb(
        new Error("只能上传图片")
      );
    }

    cb(null, true);
  }
});

app.post(
  "/api/image",
  adminOnly,
  upload.single("image"),
  (req, res) => {
    if (!req.file) {
      return res.status(400).json({
        error: "没有图片"
      });
    }

    const data = readDB();

    if (data.image) {
      const oldFile = path.join(
        uploadDir,
        path.basename(data.image)
      );

      if (fs.existsSync(oldFile)) {
        fs.unlinkSync(oldFile);
      }
    }

    data.image =
      "/uploads/" + req.file.filename;

    writeDB(data);

    res.json({
      ok: true
    });
  }
);

app.delete(
  "/api/image",
  adminOnly,
  (req, res) => {
    const data = readDB();

    if (data.image) {
      const oldFile = path.join(
        uploadDir,
        path.basename(data.image)
      );

      if (fs.existsSync(oldFile)) {
        fs.unlinkSync(oldFile);
      }
    }

    data.image = "";

    writeDB(data);

    res.json({
      ok: true
    });
  }
);

app.use(
  "/uploads",
  express.static(uploadDir)
);

app.use(
  (err, req, res, next) => {
    res.status(400).json({
      error:
        err.message ||
        "请求失败"
    });
  }
);

app.listen(PORT, () => {
  console.log(
    "Server running on port " + PORT
  );
});